# URL pública do projeto Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable/anon). Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxx
# URL final do site, sem barra no fim
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp de fallback (somente dígitos, com DDI 55) caso as configurações do banco falhem
NEXT_PUBLIC_WHATSAPP_NUMBER=5524992011676

# --- SOMENTE SERVIDOR (nunca usar prefixo NEXT_PUBLIC_) ---
# Segredo compartilhado entre a rota /api/contato e o gatilho do banco que protege mensagens_contato.
# Gere com: openssl rand -hex 32  (o hash SHA-256 dele fica gravado no banco; ver README)
CONTACT_FORM_SECRET=
# Opcional. Usada apenas localmente pelo script `pnpm seed:images`. Nunca commitar.
SUPABASE_SERVICE_ROLE_KEY=
